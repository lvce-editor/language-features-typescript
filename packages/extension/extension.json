{
  "id": "builtin.language-features-typescript",
  "name": "Language Features TypeScript",
  "workerName": "TypeScript Language Features Worker",
  "description": "TypeScript Language Support",
  "browser": "dist/languageFeaturesTypeScriptMain.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'", "connect-src 'self'"],
  "configuration": {
    "typescript.useTs7": {
      "type": "boolean",
      "default": false,
      "description": "Use the application-bundled native TypeScript 7 language server instead of the bundled TypeScript 7 WebAssembly worker. Requires a native LVCE host. Reload the window after changing this setting."
    }
  },
  "rpc": [
    {
      "id": "builtin.language-features-typescript.typescript-worker",
      "type": "web-worker",
      "name": "TypeScript Worker",
      "url": "../../typescriptWorkerMain.js",
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self' 'unsafe-eval'", "connect-src 'self'"]
    }
  ],
  "repository": "https://github.com/lvce-editor/language-features-typescript",
  "icon": "media/icon.png",
  "activation": [
    "onCompletion:typescript",
    "onCompletion:javascript",
    "onDiagnostic:javascript",
    "onDiagnostic:typescript",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onCommand:typescript.showPerformanceTrace",
    "onCommand:typescript.getProjectCacheStatistics"
  ],
  "completionProviders": [
    {
      "id": "typescript.provideCompletions.javascript",
      "languageId": "javascript"
    },
    {
      "id": "typescript.provideCompletions.typescript",
      "languageId": "typescript"
    },
    {
      "id": "typescript.provideCompletions.typescriptreact",
      "languageId": "typescriptreact"
    },
    {
      "id": "typescript.provideCompletions.javascriptreact",
      "languageId": "javascriptreact"
    }
  ],
  "diagnosticProviders": [
    {
      "id": "typescript.provideDiagnostics.javascript",
      "languageId": "javascript"
    },
    {
      "id": "typescript.provideDiagnostics.typescript",
      "languageId": "typescript"
    },
    {
      "id": "typescript.provideDiagnostics.typescriptreact",
      "languageId": "typescriptreact"
    },
    {
      "id": "typescript.provideDiagnostics.javascriptreact",
      "languageId": "javascriptreact"
    }
  ],
  "commands": [
    {
      "id": "typescript.showPerformanceTrace",
      "label": "TypeScript: Show Performance Trace"
    },
    {
      "id": "typescript.getProjectCacheStatistics",
      "label": "TypeScript: Get Project Cache Statistics"
    }
  ],
  "languages": [
    {
      "id": "typescript",
      "extensions": [".ts"]
    },
    {
      "id": "typescriptreact",
      "extensions": [".tsx"]
    },
    {
      "id": "javascript",
      "extensions": [".js"]
    },
    {
      "id": "javascriptreact",
      "extensions": [".jsx"]
    }
  ],
  "jsonValidation": [
    {
      "fileMatch": "tsconfig.json",
      "url": "./schemas/tsconfig.schema.json"
    },
    {
      "fileMatch": "tsconfig-*.json",
      "url": "./schemas/tsconfig.schema.json"
    },
    {
      "fileMatch": "tsconfig.*.json",
      "url": "./schemas/tsconfig.schema.json"
    },
    {
      "fileMatch": "jsconfig.json",
      "url": "./schemas/jsconfig.schema.json"
    },
    {
      "fileMatch": "jsconfig.*.json",
      "url": "./schemas/jsconfig.schema.json"
    }
  ],
  "optionalLanguageServers": [
    {
      "id": "typescript.ts7.javascript",
      "connectionId": "typescript.ts7",
      "languageId": "javascript",
      "activationCommand": "typescript.awaitActivation"
    },
    {
      "id": "typescript.ts7.javascriptreact",
      "connectionId": "typescript.ts7",
      "languageId": "javascriptreact",
      "activationCommand": "typescript.awaitActivation"
    },
    {
      "id": "typescript.ts7.typescript",
      "connectionId": "typescript.ts7",
      "languageId": "typescript",
      "activationCommand": "typescript.awaitActivation"
    },
    {
      "id": "typescript.ts7.typescriptreact",
      "connectionId": "typescript.ts7",
      "languageId": "typescriptreact",
      "activationCommand": "typescript.awaitActivation"
    }
  ]
}
